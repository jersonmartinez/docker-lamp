# Database Configuration
# DB_IMAGE selects the database engine image. Defaults to mysql:8.0.
# Use a MariaDB image (e.g. mariadb:11.4) for apps that rely on MariaDB-only
# SQL such as "ALTER TABLE ... ADD COLUMN IF NOT EXISTS".
DB_IMAGE=mysql:8.0
# MYSQL_HOST is the hostname the PHP app uses to reach the database. It must
# match the compose service name ("db"); it is referenced by docker-compose.yml.
MYSQL_HOST=db
MYSQL_DATABASE=dbname
MYSQL_USER=dbuser
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# PHPMyAdmin Configuration
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=your_secure_root_password_here

# Ports Configuration (for development only)
APACHE_PORT=80
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=30
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=20M
